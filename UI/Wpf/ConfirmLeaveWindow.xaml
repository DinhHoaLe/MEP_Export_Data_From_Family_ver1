<Window x:Class="Export_Data_From_Family.UI.Wpf.ConfirmLeaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unfinished transfer" Width="510" Height="265"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F5F2EE"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="126"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#62543C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#B3A491" BorderThickness="1" Background="#F5F2EE">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#D1C8BF">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                            MouseLeftButtonDown="Header_Drag">
                    <Border Width="21" Height="21" CornerRadius="4" Background="#62543C" Margin="0,0,9,0">
                        <TextBlock Text="!" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Unfinished transfer" Foreground="#37322B" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="×" FontSize="20" Foreground="#37322B"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Keep working" Click="KeepWorking_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="26,25,26,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="#E8E2DA"
                        BorderBrush="#90805C" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#6F6044"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="WarningText" FontSize="16" FontWeight="SemiBold"
                               Foreground="#37322B" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText" Foreground="#716B63" TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#DDD6CE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,22,0">
                    <Button Content="Leave transfer" Style="{StaticResource DialogButton}"
                            Background="White" Foreground="#37322B" BorderBrush="#DDD6CE"
                            BorderThickness="1" Click="Leave_Click" Margin="0,0,10,0"/>
                    <Button Content="Keep working" Style="{StaticResource DialogButton}"
                            IsDefault="True" IsCancel="True" Click="KeepWorking_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
