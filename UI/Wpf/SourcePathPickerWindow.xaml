<Window x:Class="Export_Data_From_Family.UI.Wpf.SourcePathPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose source" Width="720" Height="570" MinWidth="600" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F5F2EE"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Background" Value="#62543C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#B3A491" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="#D1C8BF" MouseLeftButtonDown="Header_Drag">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock Text="FAMILY DATA STUDIO  ·  CHOOSE SOURCE" Foreground="#37322B"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="17,0,0,0"/>
                <Button Grid.Column="1" Content="×" FontSize="20" BorderThickness="0"
                        Background="Transparent" Click="Cancel_Click" Cursor="Hand"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="24,22,24,16">
                <TextBlock x:Name="PickerTitle" Text="Choose a family folder" FontSize="22"
                           FontWeight="SemiBold" Foreground="#37322B"/>
                <TextBlock x:Name="PickerHint" Foreground="#716B63" Margin="0,5,0,16"/>
                <TextBlock Text="PATH" Foreground="#6F6044" FontSize="11" FontWeight="Bold"/>
                <TextBox x:Name="PathBox" Height="39" Padding="11,8" Background="White"
                         BorderBrush="#DDD6CE" BorderThickness="1" Foreground="#37322B"
                         Margin="0,6,0,0" TextChanged="PathBox_Changed"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="24,0,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="12" BorderBrush="#DDD6CE" BorderThickness="1" Padding="12">
                    <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"/>
                </Border>
                <Border x:Name="FilesPanel" Grid.Column="2" Background="White" CornerRadius="12"
                        BorderBrush="#DDD6CE" BorderThickness="1" Padding="12" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Text="JSON REPORTS" DockPanel.Dock="Top" Foreground="#6F6044"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListBox x:Name="FileList" BorderThickness="0" SelectionChanged="FileList_SelectionChanged"/>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="24,17,24,22">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationText" Foreground="#8E4F42" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource ActionButton}"
                        Background="White" Foreground="#37322B" BorderBrush="#DDD6CE"
                        BorderThickness="1" Click="Cancel_Click"/>
                <Button Grid.Column="3" Content="Use this path" Style="{StaticResource ActionButton}"
                        Click="Accept_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
