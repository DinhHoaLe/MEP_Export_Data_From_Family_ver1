<Window x:Class="Export_Data_From_Family.UI.Wpf.FamilyWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Family Data Studio" Width="1100" Height="790"
        Icon="pack://application:,,,/Export_Data_From_Family;component/UI/Wpf/Assets/family-export-symbol.png"
        MinWidth="940" MinHeight="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged"
        Closing="Window_Closing" Background="#F5F2EE" FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#90805C"/>
        <SolidColorBrush x:Key="AccentDark" Color="#6F6044"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#62543C"/>
        <SolidColorBrush x:Key="Ink" Color="#37322B"/>
        <SolidColorBrush x:Key="Muted" Color="#716B63"/>
        <SolidColorBrush x:Key="Line" Color="#DDD6CE"/>
        <SolidColorBrush x:Key="Surface" Color="#F5F2EE"/>
        <SolidColorBrush x:Key="ProgressInactive" Color="#E8E2DA"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="Input" TargetType="Control">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#514631"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Background" Value="#C2C6C5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#EEE8E1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#EEE8E1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#C2C6C5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="39"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#E8E2DA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chromeSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chromeSurface" Property="Background" Value="#B3A491"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chromeSurface" Property="Background" Value="#90805C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="marker" Width="18" Height="18" CornerRadius="4"
                                    Background="White" BorderBrush="#B3A491" BorderThickness="1.4">
                                <TextBlock x:Name="mark" Text="✓" Foreground="White" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,-2,0,0"/>
                            </Border>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="marker" Property="Background" Value="{StaticResource AccentDark}"/>
                                <Setter TargetName="marker" Property="BorderBrush" Value="{StaticResource AccentDark}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="marker" Width="16" Height="16" CornerRadius="3"
                                    Background="White" BorderBrush="#B3A491" BorderThickness="1.3">
                                <TextBlock x:Name="mark" Text="✓" Foreground="{StaticResource AccentDark}" FontSize="11"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,-2,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="marker" Property="BorderBrush" Value="{StaticResource AccentDark}"/>
                                <Setter TargetName="marker" Property="Background" Value="#E8E2DA"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
            <Setter Property="RowHeight" Value="66"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternatingRowBackground" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="rowSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                CornerRadius="10" Margin="2,3">
                            <DataGridCellsPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="rowSurface" Property="Background" Value="#F2EEE9"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowSurface" Property="Background" Value="#E8E2DA"/>
                                <Setter TargetName="rowSurface" Property="BorderBrush" Value="#C8BCAC"/>
                                <Setter TargetName="rowSurface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="rowSurface" Property="Background" Value="#E8E2DA"/>
                                <Setter TargetName="rowSurface" Property="BorderBrush" Value="#C8BCAC"/>
                                <Setter TargetName="rowSurface" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AlreadyExists}" Value="True">
                                <Setter TargetName="rowSurface" Property="Background" Value="#E2E5E4"/>
                                <Setter TargetName="rowSurface" Property="BorderBrush" Value="#C2C6C5"/>
                                <Setter TargetName="rowSurface" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredGridText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BatchChipButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipSurface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#D1C8BF">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image Source="pack://application:,,,/Export_Data_From_Family;component/UI/Wpf/Assets/family-export-symbol.png"
                       Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="Family Data Studio" Foreground="{StaticResource Ink}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}" ToolTip="Minimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
                    <Path Data="M0,0 L12,0" Stroke="{StaticResource Ink}" StrokeThickness="1.2" Width="12" Height="1"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" ToolTip="Maximize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click">
                    <Path Data="M1,1 L11,1 11,10 1,10 Z" Stroke="{StaticResource Ink}"
                          StrokeThickness="1.2" Fill="Transparent" Width="12" Height="11"/>
                </Button>
                <Button Style="{StaticResource ChromeButton}" ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click">
                    <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{StaticResource Ink}"
                          StrokeThickness="1.3" Width="12" Height="12"/>
                </Button>
            </StackPanel>
            <Border Height="1" Background="#C8BCAC" VerticalAlignment="Bottom"/>
        </Grid>
    <Grid Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="38,32,38,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/><ColumnDefinition Width="18"/>
                <ColumnDefinition/><ColumnDefinition Width="470"/>
            </Grid.ColumnDefinitions>
            <Border Width="70" Height="70" CornerRadius="12" Background="#D1C8BF"
                    BorderBrush="#C8BCAC" BorderThickness="1" VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Export_Data_From_Family;component/UI/Wpf/Assets/family-export-symbol.png"
                       Stretch="Uniform" Margin="3"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="StepText" Foreground="{StaticResource AccentDark}" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="TitleText" Foreground="{StaticResource Ink}" FontSize="27"
                           FontWeight="SemiBold" Margin="0,3,0,3" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid Grid.Column="3" VerticalAlignment="Top">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Border x:Name="ProgressWelcome" Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="ProgressWelcomeText" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Welcome" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Border x:Name="ProgressSource" Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="ProgressSourceText" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choose&#10;source" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Border x:Name="ProgressOne" Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="ProgressOneText" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choose&#10;families" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <Border x:Name="ProgressTwo" Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="ProgressTwoText" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choose&#10;parameters" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <Border x:Name="ProgressThree" Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="ProgressThreeText" Text="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Review &amp;&#10;transfer" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="0" Grid.ColumnSpan="2" Width="48" Height="1"
                        Background="{StaticResource Line}" VerticalAlignment="Top" Margin="0,17,0,0" IsHitTestVisible="False"/>
                <Border Grid.Column="1" Grid.ColumnSpan="2" Width="48" Height="1"
                        Background="{StaticResource Line}" VerticalAlignment="Top" Margin="0,17,0,0" IsHitTestVisible="False"/>
                <Border Grid.Column="2" Grid.ColumnSpan="2" Width="48" Height="1"
                        Background="{StaticResource Line}" VerticalAlignment="Top" Margin="0,17,0,0" IsHitTestVisible="False"/>
                <Border Grid.Column="3" Grid.ColumnSpan="2" Width="48" Height="1"
                        Background="{StaticResource Line}" VerticalAlignment="Top" Margin="0,17,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="38,0,38,0">
            <Grid x:Name="StepWelcome" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Image Source="pack://application:,,,/Export_Data_From_Family;component/UI/Wpf/Assets/family-data-hero.png"
                               Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <StackPanel Grid.Row="1" Margin="32,17,32,30">
                            <TextBlock Text="FAMILY DATA STUDIO" Foreground="{StaticResource AccentDark}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Understand the data inside every family" Foreground="{StaticResource Ink}"
                                       FontSize="25" FontWeight="SemiBold" Margin="0,7,0,6"/>
                            <TextBlock Text="Explore family parameters, compare definitions and transfer the data you need into the open family."
                                       Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="StepSource" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Source information" Foreground="{StaticResource Ink}"
                                   FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose a family folder to analyze, or open a report you already have."
                                   Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,22"/>

                        <Grid Margin="10,0,0,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="{StaticResource ProgressInactive}"
                                    VerticalAlignment="Top">
                                <Path Data="M3,7 L10,7 13,10 24,10 24,21 3,21 Z M3,11 L24,11"
                                      Stroke="{StaticResource AccentDark}" StrokeThickness="1.8" Fill="Transparent"
                                      Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <RadioButton x:Name="FolderModeRadio" Content="Family folder (.rfa)"
                                             GroupName="SourceMode" Style="{StaticResource OptionRadio}"
                                             FontWeight="SemiBold" IsChecked="True" Checked="SourceMode_Changed"/>
                                <TextBlock Text="Analyze the families and create a fresh JSON report."
                                           Foreground="{StaticResource Muted}" Margin="26,5,0,11"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="FolderPathBox" Style="{StaticResource Input}" Height="44"
                                             Margin="0" VerticalContentAlignment="Center" TextChanged="SourcePath_Changed"
                                             ToolTip="Paste the full path to a folder containing .rfa files"/>
                                    <Button x:Name="BrowseFolderButton" Grid.Column="2" Content="Browse…"
                                            Style="{StaticResource SecondaryButton}" Height="44" Padding="12,0"
                                            VerticalAlignment="Top" Click="BrowseSource_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="10,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="10" Background="{StaticResource ProgressInactive}"
                                    VerticalAlignment="Top">
                                <Path Data="M6,3 L19,3 24,8 24,25 6,25 Z M19,3 L19,8 24,8 M10,13 L20,13 M10,17 L20,17 M10,21 L17,21"
                                      Stroke="{StaticResource AccentDark}" StrokeThickness="1.8" Fill="Transparent"
                                      Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <RadioButton x:Name="JsonModeRadio" Content="Existing JSON report"
                                             GroupName="SourceMode" Style="{StaticResource OptionRadio}"
                                             FontWeight="SemiBold" Checked="SourceMode_Changed"/>
                                <TextBlock Text="Read a report exported earlier without analyzing again."
                                           Foreground="{StaticResource Muted}" Margin="26,5,0,11"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="JsonPathBox" Style="{StaticResource Input}" Height="44"
                                             Margin="0" VerticalContentAlignment="Center" TextChanged="SourcePath_Changed"
                                             ToolTip="Paste the full path to a JSON report"/>
                                    <Button x:Name="BrowseJsonButton" Grid.Column="2" Content="Browse…"
                                            Style="{StaticResource SecondaryButton}" Height="44" Padding="12,0"
                                            VerticalAlignment="Top" Click="BrowseSource_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="SourcePathHint" Foreground="{StaticResource Muted}"
                                   Margin="78,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="StepLoading" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Margin="0" Padding="40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Grid Width="150" Height="150" Margin="0,0,0,22">
                            <Border Width="112" Height="136" CornerRadius="12" Background="#D1C8BF"
                                    BorderBrush="#B3A491" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                <StackPanel Margin="16,18">
                                    <Border Height="12" Width="62" Background="#B3A491" CornerRadius="4" HorizontalAlignment="Left"/>
                                    <Border Height="7" Width="72" Background="White" CornerRadius="3" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                                    <Border Height="7" Width="56" Background="White" CornerRadius="3" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                    <Border Height="7" Width="66" Background="White" CornerRadius="3" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Width="76" Height="82" CornerRadius="12" Background="White"
                                    BorderBrush="{StaticResource AccentDark}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⌂" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentDark}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="FAMILY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentDark}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="LoadingTitle" Text="Preparing family data" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingDetail" Text="Reading family names, categories and parameters from the JSON report."
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Margin="0,10,0,22"/>
                        <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Height="6" Width="280" Foreground="{StaticResource Accent}"
                                     Background="#E8E2DA" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="StepOne">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/><ColumnDefinition Width="6"/><ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="6"/><ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FAMILIES IN REPORT" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="FamilyCountText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="7">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,8,2"/>
                                <TextBox x:Name="FamilySearch" Grid.Column="1" Height="39" Background="Transparent"
                                         BorderThickness="0" VerticalContentAlignment="Center"
                                         Foreground="{StaticResource Ink}" TextChanged="FamilySearch_Changed"
                                         ToolTip="Search family name or category"/>
                            </Grid>
                        </Border>
                        <Button x:Name="FamilyFilterButton" Grid.Column="3" Style="{StaticResource ToolbarButton}"
                                ToolTip="Filter by category" Click="FamilyFilter_Click">
                            <Path Data="M2,3 L18,3 11,10 11,17 9,19 9,10 Z" Fill="{StaticResource Muted}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="FamilySortButton" Grid.Column="5" Style="{StaticResource ToolbarButton}"
                                ToolTip="Sort families" Click="FamilySort_Click">
                            <Path Data="M5,3 L5,18 M2,6 L5,3 8,6 M15,18 L15,3 M12,15 L15,18 18,15"
                                  Stroke="{StaticResource Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Grid.Column="7" Style="{StaticResource ToolbarButton}"
                                ToolTip="Select all visible families" Click="FamilyAll_Click">
                            <Path Data="M3,4 L17,4 17,18 3,18 Z M6,11 L9,14 14,8"
                                  Stroke="{StaticResource Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" ClipToBounds="True">
                    <DataGrid x:Name="FamilyGrid" Style="{StaticResource GridStyle}" SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="FamilyGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="FamilySelectAllCheck" Style="{StaticResource PrimaryCheck}"
                                              ToolTip="Select or clear all visible families" HorizontalAlignment="Center"
                                              Checked="FamilySelectAll_Changed" Unchecked="FamilySelectAll_Changed"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox Style="{StaticResource PrimaryCheck}" ToolTip="Include this family"
                                              HorizontalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FAMILY NAME" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource Muted}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="235"
                                                ElementStyle="{StaticResource CenteredGridText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid x:Name="StepTwo" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/><ColumnDefinition Width="6"/><ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="6"/><ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ParameterSummaryText" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="DestinationText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="7">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="0,0,8,2"/>
                                <TextBox x:Name="ParameterSearch" Grid.Column="1" Height="39" Background="Transparent"
                                         BorderThickness="0" VerticalContentAlignment="Center"
                                         Foreground="{StaticResource Ink}" TextChanged="ParameterSearch_Changed"
                                         ToolTip="Search parameter"/>
                            </Grid>
                        </Border>
                        <Button x:Name="ParameterFilterButton" Grid.Column="3" Style="{StaticResource ToolbarButton}"
                                ToolTip="Filter parameters" Click="ParameterFilter_Click">
                            <Path Data="M2,3 L18,3 11,10 11,17 9,19 9,10 Z" Fill="{StaticResource Muted}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="ParameterSortButton" Grid.Column="5" Style="{StaticResource ToolbarButton}"
                                ToolTip="Sort parameters" Click="ParameterSort_Click">
                            <Path Data="M5,3 L5,18 M2,6 L5,3 8,6 M15,18 L15,3 M12,15 L15,18 18,15"
                                  Stroke="{StaticResource Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Grid.Column="7" Style="{StaticResource ToolbarButton}"
                                ToolTip="Select all visible available parameters" Click="ParameterAll_Click">
                            <Path Data="M3,4 L17,4 17,18 3,18 Z M6,11 L9,14 14,8"
                                  Stroke="{StaticResource Muted}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="White" CornerRadius="16" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" ClipToBounds="True">
                    <DataGrid x:Name="ParameterGrid" Style="{StaticResource GridStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="ParameterGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ParameterSelectAllCheck" Style="{StaticResource PrimaryCheck}"
                                              ToolTip="Select or clear all visible available parameters" HorizontalAlignment="Center"
                                              Checked="ParameterSelectAll_Changed" Unchecked="ParameterSelectAll_Changed"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox Style="{StaticResource PrimaryCheck}" ToolTip="Include this parameter"
                                              HorizontalAlignment="Center" IsEnabled="{Binding CanTransfer}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FAMILY / TYPE" Width="310">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FamilyName}" TextAlignment="Left"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="276"
                                                   ToolTip="{Binding FamilyName}"/>
                                        <TextBlock Text="{Binding FamilyTypeName}" FontSize="11"
                                                   Foreground="{StaticResource Muted}" TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="276" Margin="0,3,0,0"
                                                   ToolTip="{Binding FamilyTypeTooltip}"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PARAMETER" Binding="{Binding Name}" Width="2*"
                                                ElementStyle="{StaticResource CenteredGridText}"/>
                            <DataGridTextColumn Header="VALUE TYPE" Binding="{Binding StorageType}" Width="105"
                                                ElementStyle="{StaticResource CenteredGridText}"/>
                            <DataGridTextColumn Header="PARAM SCOPE" Binding="{Binding Scope}" Width="85"
                                                ElementStyle="{StaticResource CenteredGridText}"/>
                            <DataGridTextColumn Header="IN OPEN FAMILY" Binding="{Binding Availability}" Width="155"
                                                ElementStyle="{StaticResource CenteredGridText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid x:Name="StepThree" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,15">
                        <StackPanel>
                            <Border x:Name="TransferSuccessBanner" Visibility="Collapsed"
                                    Background="#E8E2DA" BorderBrush="#B3A491" BorderThickness="1"
                                    CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="{StaticResource AccentDark}"
                                               FontSize="16" FontWeight="Bold" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TransferSuccessText" Foreground="{StaticResource Ink}"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="BatchCurrentText" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BatchProgressText" Grid.Column="1" Foreground="{StaticResource AccentDark}"
                                           FontWeight="SemiBold" Margin="18,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Click any parameter to review it. Use × to remove an item you do not need."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,10"/>
                            <ProgressBar x:Name="BatchProgressBar" Height="4" Foreground="{StaticResource Accent}"
                                         Background="#E8E2DA" BorderThickness="0" Margin="0,0,0,11"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="BatchItemsPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SOURCE PARAMETER" Foreground="{StaticResource Ink}" FontWeight="Bold" Margin="0,0,0,14"/>
                                <TextBlock Text="NAME &amp; DEFINITION" Style="{StaticResource Field}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Family" Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="SourceFamilyPreview" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Grid.Row="1" Text="Parameter" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SourceParameterPreview" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="2" Text="Data type" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SourceDatatypePreview" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="3" Text="Group" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SourceGroupPreview" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="4" Text="Scope" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SourceScopePreview" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="5" Text="Format" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SourceFormatPreview" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,13"/>
                                <TextBlock Text="VALUE &amp; FORMULA" Style="{StaticResource Field}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Value" Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="SourceValuePreview" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Grid.Row="1" Text="Formula" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SourceFormulaPreview" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"
                                               Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DESTINATION PREVIEW" Foreground="{StaticResource Ink}" FontWeight="Bold" Margin="0,0,0,14"/>
                                <TextBlock Text="NAME &amp; DEFINITION" Style="{StaticResource Field}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Family" Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="DestinationFamilyPreview" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Grid.Row="1" Text="Parameter" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DestinationParameterPreview" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="2" Text="Data type" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DestinationDatatypePreview" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="3" Text="Group" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DestinationGroupPreview" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="4" Text="Scope" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DestinationScopePreview" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="5" Text="Format" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DestinationFormatPreview" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,13"/>
                                <TextBlock Text="VALUE &amp; FORMULA" Style="{StaticResource Field}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Value" Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="DestinationValuePreview" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Grid.Row="1" Text="Formula" Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DestinationFormulaPreview" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"
                                               Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                <ScrollViewer x:Name="OptionsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="ChangeFormatCheck" Content="Change format" Style="{StaticResource PrimaryCheck}"
                                      FontSize="16" FontWeight="SemiBold"
                                      Checked="TransferOptions_Changed" Unchecked="TransferOptions_Changed"/>
                            <TextBlock Text="Change parameter group, scope and unit display" Foreground="{StaticResource Muted}" Margin="22,4,0,0"/>
                            <Grid x:Name="FormatFields" Visibility="Collapsed" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PARAMETER GROUP" Style="{StaticResource Field}"/>
                                    <ComboBox x:Name="GroupBox" Style="{StaticResource Input}" SelectionChanged="TransferOptions_Changed"/>
                                    <TextBlock Text="DISPLAY UNIT" Style="{StaticResource Field}"/>
                                    <ComboBox x:Name="UnitBox" Style="{StaticResource Input}" SelectionChanged="Unit_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SCOPE" Style="{StaticResource Field}"/>
                                    <ComboBox x:Name="ScopeBox" Style="{StaticResource Input}" SelectionChanged="TransferOptions_Changed">
                                        <ComboBoxItem Content="Type"/><ComboBoxItem Content="Instance"/>
                                    </ComboBox>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="PRECISION" Style="{StaticResource Field}"/>
                                            <ComboBox x:Name="PrecisionBox" Style="{StaticResource Input}" SelectionChanged="TransferOptions_Changed"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="SYMBOL" Style="{StaticResource Field}"/>
                                            <ComboBox x:Name="SymbolBox" Style="{StaticResource Input}" SelectionChanged="TransferOptions_Changed"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="FormatNote" Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CopyDataCheck" Content="Copy value or formula" Style="{StaticResource PrimaryCheck}"
                                      FontSize="16" FontWeight="SemiBold"
                                      Checked="TransferOptions_Changed" Unchecked="TransferOptions_Changed"/>
                            <TextBlock Text="Choose a source Type first, then select one option" Foreground="{StaticResource Muted}" Margin="22,4,0,0"/>
                            <StackPanel x:Name="DataFields" Visibility="Collapsed" Margin="0,18,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="SOURCE TYPE" Style="{StaticResource Field}"/>
                                        <ComboBox x:Name="SourceTypeBox" Style="{StaticResource Input}" SelectionChanged="SourceType_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="VALUE IN SOURCE" Style="{StaticResource Field}"/>
                                        <TextBlock x:Name="SourceValueText" Foreground="{StaticResource AccentDark}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,8,0,8">
                                    <StackPanel>
                                        <TextBlock Text="CHOOSE ONE" Style="{StaticResource Field}"/>
                                        <RadioButton x:Name="CopyValueRadio" Content="Copy value" GroupName="CopyMode"
                                                     Style="{StaticResource OptionRadio}" Margin="0,0,0,12"
                                                     Checked="TransferOptions_Changed"/>
                                        <RadioButton x:Name="CopyFormulaRadio" Content="Copy formula" GroupName="CopyMode"
                                                     Style="{StaticResource OptionRadio}" Checked="TransferOptions_Changed"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="ValueFields" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="DESTINATION TYPE" Style="{StaticResource Field}"/>
                                    <ComboBox x:Name="DestinationTypeBox" Style="{StaticResource Input}" SelectionChanged="TransferOptions_Changed"/>
                                    <TextBlock x:Name="ValueNote" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <StackPanel x:Name="FormulaFields" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="FORMULA TO APPLY" Style="{StaticResource Field}"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="FormulaBox" Style="{StaticResource Input}" MinHeight="62" MaxHeight="100"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 TextChanged="Formula_Changed"/>
                                        <Button Grid.Column="2" Content="Check formula" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Top" Click="CheckFormula_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="FormulaHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FormulaResult" Foreground="{StaticResource AccentDark}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ADVANCED OPTIONS" Foreground="{StaticResource Ink}" FontWeight="Bold" Margin="0,0,0,14"/>
                            <CheckBox x:Name="MatchTypesCheck" Content="Copy values to Types with matching names"
                                      Style="{StaticResource PrimaryCheck}" IsEnabled="False"
                                      Checked="TransferOptions_Changed" Unchecked="TransferOptions_Changed"/>
                            <TextBlock Text="Uses values from all source Types. Destination Types without a matching name are skipped."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,5,0,17"/>
                            <Button Content="Reset options for this parameter" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Click="ResetOptions_Click"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>

        <Grid Grid.Row="2" Background="#F5F2EE" Margin="38,18,38,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentDark}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,18,0"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click" Visibility="Collapsed" MinWidth="90"/>
            <Button x:Name="BackButton" Grid.Column="3" Content="←  Back" Style="{StaticResource SecondaryButton}"
                    Click="Back_Click" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Grid.Column="5" Content="Continue  →" Style="{StaticResource PrimaryButton}"
                    Click="Next_Click" Visibility="Collapsed" IsEnabled="False" MinWidth="132"/>
            <Button x:Name="ExitButton" Grid.Column="5" Content="Exit" Style="{StaticResource SecondaryButton}"
                    Click="Exit_Click" Visibility="Collapsed" MinWidth="90"/>
            <Button x:Name="TransferButton" Grid.Column="7" Content="Transfer" Style="{StaticResource PrimaryButton}"
                    Click="Transfer_Click" Visibility="Collapsed"/>
        </Grid>
    </Grid>
    </Grid>
</Window>
